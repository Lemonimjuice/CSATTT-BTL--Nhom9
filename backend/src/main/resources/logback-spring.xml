<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <springProfile name="!prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) [%cyan(%thread)] [reqId=%yellow(%X{requestId:-none})] [user=%green(%X{userId:-anonymous})] [ip=%X{clientIp:-?}] %logger{40} - %msg%n</pattern>
            </encoder>
        </appender>

        <!-- Audit log tập trung: khi chạy trong container, logs/ được mount ra thư mục logs/ trên máy -->
        <appender name="AUDIT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <!-- Bỏ dòng healthcheck nội bộ của Docker (mỗi 10 giây) để audit log chỉ còn sự kiện thật -->
            <filter class="com.blogapi.config.LocalHealthCheckLogFilter"/>
            <file>logs/audit.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>logs/audit.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <maxFileSize>10MB</maxFileSize>
                <maxHistory>30</maxHistory>
            </rollingPolicy>
            <encoder>
                <!-- XXX: ghi kèm múi giờ (Z = UTC; giờ Việt Nam = UTC+7) để đối chiếu với ảnh chụp không nhầm -->
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS XXX} %-5level [reqId=%X{requestId:-none}] [user=%X{userId:-anonymous}] [ip=%X{clientIp:-?}] %logger{40} - %msg%n</pattern>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="AUDIT_FILE"/>
        </root>

        <logger name="com.blogapi" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="AUDIT_FILE"/>
        </logger>
    </springProfile>

    <springProfile name="prod">
        <!-- Rolling file appender for production -->
        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>logs/blog-api.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
                <fileNamePattern>logs/blog-api.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                    <maxFileSize>10MB</maxFileSize>
                </timeBasedFileNamingAndTriggeringPolicy>
                <maxHistory>30</maxHistory>
            </rollingPolicy>
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [reqId=%X{requestId:-none}] [user=%X{userId:-anonymous}] %logger{40} - %msg%n</pattern>
            </encoder>
        </appender>

        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [reqId=%X{requestId:-none}] [user=%X{userId:-anonymous}] %logger{40} - %msg%n</pattern>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="FILE"/>
            <appender-ref ref="CONSOLE"/>
        </root>

        <logger name="com.blogapi" level="INFO" additivity="false">
            <appender-ref ref="FILE"/>
            <appender-ref ref="CONSOLE"/>
        </logger>
    </springProfile>

</configuration>
