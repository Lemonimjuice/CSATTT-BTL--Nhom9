# Local-only, disposable lab credentials. Copy to .env.sqli-lab (ignored by Git).
# Replace both placeholders with different, freshly generated random values.
# These credentials do not change the existing business PostgreSQL password or JWT key.
SQLI_LAB_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_LAB_ADMIN_PASSWORD
SQLI_LAB_READER_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_LAB_READER_PASSWORD
