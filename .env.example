# Mẫu biến môi trường cho docker-compose.yml ở thư mục gốc.
# Cách nhanh nhất: `sh scripts/init-env.sh` tự sinh .env với mọi giá trị ngẫu nhiên.
# Hoặc sao chép thành .env rồi thay MỌI giá trị bằng chuỗi ngẫu nhiên mới (không commit .env).
# Sinh tay (Git Bash):
#   openssl rand -base64 32        -> JWT_SECRET
#   openssl rand -hex 24           -> các mật khẩu (48 ký tự)

# Tài khoản quản trị PostgreSQL: chỉ dùng để chạy script khởi tạo, backend KHÔNG dùng tài khoản này.
DB_ADMIN_PASSWORD=CHANGE_ME_RANDOM_ADMIN_PASSWORD

# Tài khoản ứng dụng (Least Privilege), do database/init/02-least-privilege.sql tạo.
# Mật khẩu tối thiểu 24 ký tự, nếu ngắn hơn script 02 sẽ dừng và backend không đăng nhập được DB.
APP_DB_USERNAME=app_user
APP_DB_PASSWORD=CHANGE_ME_RANDOM_APP_PASSWORD_AT_LEAST_24_CHARS

# Khóa ký JWT dùng chung cho 2 node backend: Base64 của ít nhất 32 byte ngẫu nhiên.
JWT_SECRET=REPLACE_WITH_BASE64_OF_32_RANDOM_BYTES

# Chế độ WAF: On (chặn, mặc định) hoặc DetectionOnly (chỉ ghi log, dùng cho Demo 3).
WAF_MODE=On

# Mật khẩu tài khoản chỉ-đọc cho database sqli_lab (cụm API lỗi /api/v1/vuln).
# database/init/04-sqli-demo.sh tạo tài khoản này; 2 node backend dùng để truy vấn lab.
SQLI_LAB_READER_PASSWORD=CHANGE_ME_RANDOM_LAB_READER_PASSWORD
