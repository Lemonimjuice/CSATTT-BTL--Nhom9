{
  "info": {
    "name": "Nhóm 9 - Defense in Depth (toàn bộ API)",
    "description": "Bộ kiểm thử toàn bộ API qua Nginx + WAF (https://localhost). Chạy theo thứ tự thư mục bằng Collection Runner, đặt Delay 300 ms để không chạm rate limit 5 request/giây. Cần: docker compose up -d, và thêm nginx/certs/server.crt vào Postman (Settings > Certificates) hoặc tắt SSL verification. Cụm /vuln chạy ngay trên backend chính, dùng chung token với /secure.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "postAPublic", "value": "2" },
    { "key": "postADraft", "value": "3" },
    { "key": "recordA", "value": "1" },
    { "key": "catId", "value": "1" }
  ],
  "item": [
    {
      "name": "0. Auth",
      "item": [
        {
          "name": "Register tài khoản mới -> 201",
          "event": [
            { "listen": "prerequest", "script": { "exec": ["pm.variables.set('newUser','pm_' + Date.now());"] } },
            { "listen": "test", "script": { "exec": [
              "pm.test('201', () => pm.response.to.have.status(201));",
              "pm.test('Có accessToken', () => pm.expect(pm.response.json().accessToken).to.be.a('string'));"
            ] } }
          ],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"username\":\"{{newUser}}\",\"email\":\"{{newUser}}@nhom9.test\",\"password\":\"NewUser@2026\"}" },
            "url": "{{baseUrl}}/api/v1/auth/register" }
        },
        {
          "name": "Login admin",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('tokenAdmin', pm.response.json().accessToken);"
          ] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"username\":\"{{userAdmin}}\",\"password\":\"{{passAdmin}}\"}" },
            "url": "{{baseUrl}}/api/v1/auth/login" }
        },
        {
          "name": "Login User A",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "const j = pm.response.json();",
            "pm.test('Login trả email của chính mình', () => pm.expect(j.user.email).to.eql('user_a@nhom9.test'));",
            "pm.collectionVariables.set('tokenA', j.accessToken);",
            "pm.collectionVariables.set('refreshA', j.refreshToken);"
          ] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"username\":\"{{userA}}\",\"password\":\"{{passA}}\"}" },
            "url": "{{baseUrl}}/api/v1/auth/login" }
        },
        {
          "name": "Login User B",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('tokenB', pm.response.json().accessToken);"
          ] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"username\":\"{{userB}}\",\"password\":\"{{passB}}\"}" },
            "url": "{{baseUrl}}/api/v1/auth/login" }
        },
        {
          "name": "Refresh access token -> 200",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.test('Có accessToken mới', () => pm.expect(pm.response.json().accessToken).to.be.a('string'));"
          ] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"refreshToken\":\"{{refreshA}}\"}" },
            "url": "{{baseUrl}}/api/v1/auth/refresh" }
        },
        {
          "name": "Sai mật khẩu -> 401 (hoặc 429 nếu đã chạm rate limit)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('401 sai mật khẩu, hoặc 429 do rate limit đăng nhập', () => pm.expect(pm.response.code).to.be.oneOf([401, 429]));"
          ] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"username\":\"{{userA}}\",\"password\":\"sai-mat-khau\"}" },
            "url": "{{baseUrl}}/api/v1/auth/login" }
        }
      ]
    },
    {
      "name": "1. Hạ tầng (Nginx)",
      "item": [
        {
          "name": "Health qua Nginx, có X-Request-ID và X-Upstream",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 UP', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('UP'); });",
            "pm.test('X-Request-ID 32 hex', () => pm.expect(pm.response.headers.get('X-Request-ID')).to.match(/^[0-9a-f]{32}$/));",
            "pm.test('Có X-Upstream', () => pm.expect(pm.response.headers.get('X-Upstream')).to.include(':8080'));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/actuator/health" }
        },
        {
          "name": "Actuator khác bị chặn tại Nginx -> 404",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('404', () => pm.response.to.have.status(404));"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/actuator/env" }
        }
      ]
    },
    {
      "name": "2. Categories",
      "item": [
        {
          "name": "GET danh sách (public)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200', () => pm.response.to.have.status(200));"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/categories" }
        },
        {
          "name": "GET theo id (public)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200', () => pm.response.to.have.status(200));"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/categories/{{catId}}" }
        },
        {
          "name": "GET theo slug (public)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200', () => pm.response.to.have.status(200));"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/categories/slug/bao-mat-web" }
        },
        {
          "name": "User thường tạo category -> 403",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('403', () => pm.response.to.have.status(403));"] } }],
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{tokenA}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"name\":\"Khong duoc phep\"}" },
            "url": "{{baseUrl}}/api/v1/categories" }
        },
        {
          "name": "Admin tạo category -> 201",
          "event": [
            { "listen": "prerequest", "script": { "exec": ["pm.variables.set('catName','KiemThu ' + Date.now());"] } },
            { "listen": "test", "script": { "exec": [
              "pm.test('201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('newCatId', pm.response.json().id);"
            ] } }
          ],
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"name\":\"{{catName}}\",\"description\":\"tao tu Postman\"}" },
            "url": "{{baseUrl}}/api/v1/categories" }
        },
        {
          "name": "Admin sửa category -> 200",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200', () => pm.response.to.have.status(200));"] } }],
          "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"description\":\"da sua\"}" },
            "url": "{{baseUrl}}/api/v1/categories/{{newCatId}}" }
        },
        {
          "name": "Admin xóa category -> 204",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('204', () => pm.response.to.have.status(204));"] } }],
          "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }],
            "url": "{{baseUrl}}/api/v1/categories/{{newCatId}}" }
        }
      ]
    },
    {
      "name": "3. Posts",
      "item": [
        {
          "name": "GET danh sách published, author không có email",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "const posts = pm.response.json().content;",
            "pm.test('Chỉ bài PUBLISHED', () => posts.forEach(p => pm.expect(p.status).to.eql('PUBLISHED')));",
            "pm.test('Không lộ email tác giả', () => posts.forEach(p => pm.expect(p.author).to.not.have.property('email')));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/posts" }
